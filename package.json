    "@emotion/styled": "^11.10.5",
    "@fontsource/inter": "^5.1.0",
    "@hocuspocus/provider": "^1.1.1",
    "@netlify/plugin-csp-nonce": "^1.2.10",
    "@nylas/nylas-react": "^0.1.0",
    "@okta/okta-auth-js": "^7.10.1",
    "@okta/okta-react": "^6.9.0",
    "@react-oauth/google": "^0.8.0",
    "@react-pdf/renderer": "^3.4.4",
    "@rollbar/react": "^0.12.0-beta",
    "@statsig/react-bindings": "^3.8.3",
    "@statsig/session-replay": "^3.8.3",
    "@statsig/web-analytics": "^3.8.3",
