    "@tiptap/extension-placeholder": "^2.0.0-beta.220",
    "@tiptap/pm": "^2.0.0-beta.217",
    "@tiptap/react": "^2.0.0-beta.217",
    "@tiptap/starter-kit": "^2.0.0-beta.217",
    "@xyflow/react": "^12.2.1",
    "ahooks": "^3.8.1",
    "antd": "^5.15.1",
    "axios": "^1.2.2",
    "chakra-react-select": "^4.9.2",
    "chart.js": "^4.4.7",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
