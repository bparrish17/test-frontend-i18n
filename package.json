{
  "name": "Fora-Web-App",
  "private": true,
  "version": "0.11.112",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
    "dev": "vite --open",
    "dev:as-prod": "vite --open --mode production",
    "dev:no-open": "vite --no-open",
    "dev:netlify": "npm run kill-netlify 8888 && netlify dev -p 8888",
    "kill-netlify": "node scripts/kill-netlify-process.js",
    "gen:theme-typings": "chakra-cli tokens src/styles/theme.js",
    "kill-node": "pkill -f node || true",
    "lint": "npx eslint . --ext .js --ext .jsx --config .eslintrc.cjs --resolve-plugins-relative-to ./node_modules --quiet --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern build --ignore-pattern public",
    "lint:fix": "npx eslint . --ext .js --ext .jsx --config .eslintrc.cjs --resolve-plugins-relative-to ./node_modules --fix --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern build --ignore-pattern public",
    "lint:full": "npx eslint . --ext .js --ext .jsx --config .eslintrc.cjs --resolve-plugins-relative-to ./node_modules --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern build --ignore-pattern public",
    "lint:strict": "npx eslint . --ext .js --ext .jsx --config .eslintrc.cjs --resolve-plugins-relative-to ./node_modules --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern build --ignore-pattern public --max-warnings 0",
    "lint:watch": "chokidar \"src/**/*.{js,jsx}\" -c \"eslint {path}\"",
    "prepare": "husky && husky install",
    "pretty": "prettier --write . --config ./.prettierrc\n",
    "preview": "vite preview",
    "print-sonar-url": "cd .github/scripts && node printSonarURL.js",
    "release:dev": "release-it --ci --no-git.tagExist && node build-helpers/ChangelogUpdater.js",
    "release:prod": "node build-helpers/ChangelogUpdater.js --prod",
    "test": "vitest --run",
    "test-local:e2e": "./node_modules/cypress/bin/cypress  open --e2e --browser chrome",
    "test:e2e": "./node_modules/cypress/bin/cypress run --e2e --browser chrome",
    "test-coverage": "vitest --coverage --run",
    "testz": "nodemon --inspect-brk=9229 build-helpers/ChangelogUpdater.js",
    "test:watch:file": "vitest"
  },
  "lint-staged": {
    "(!test).{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.485.0",
    "@aws-sdk/client-s3": "^3.484.0",
    "@azure/msal-browser": "^3.2.0",
    "@azure/msal-common": "^14.1.0",
    "@azure/msal-react": "^2.0.4",
    "@chakra-ui/react": "^2.8.1",
